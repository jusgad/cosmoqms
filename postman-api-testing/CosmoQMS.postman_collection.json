{
  "info": {
    "name": "CosmoQMS API",
    "description": "Colección de Postman para probar las APIs reales de CosmoQMS: 3 rutas REST (Next.js Route Handlers) y 23 procedimientos tRPC (sync/materias primas/fórmulas/producción/calidad/desviaciones/trazabilidad/auditoría). Todas las rutas requieren sesión de Clerk — configura la variable {{cookie}} en el environment antes de ejecutar cualquier petición.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "cookie", "value": "PEGA_AQUI_LA_COOKIE_COPIADA_DEL_NAVEGADOR" },
    { "key": "productionOrderId", "value": "UUID_DE_UNA_ORDEN_DE_PRODUCCION" },
    { "key": "rawMaterialId", "value": "UUID_DE_UNA_MATERIA_PRIMA" },
    { "key": "rawMaterialLotId", "value": "UUID_DE_UN_LOTE_DE_MATERIA_PRIMA" },
    { "key": "formulaId", "value": "UUID_DE_UNA_FORMULA" },
    { "key": "deviationId", "value": "UUID_DE_UNA_DESVIACION" }
  ],
  "item": [
    {
      "name": "REST",
      "item": [
        {
          "name": "GET sync/state (datos para la UI offline)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Cookie", "value": "{{cookie}}" }],
            "url": { "raw": "{{baseUrl}}/api/sync/state", "host": ["{{baseUrl}}"], "path": ["api", "sync", "state"] }
          }
        },
        {
          "name": "POST sync/events (ingesta de pesajes offline)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Cookie", "value": "{{cookie}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"clientEventId\": \"{{$guid}}\",\n      \"productionOrderId\": \"{{productionOrderId}}\",\n      \"eventType\": \"weighing\",\n      \"payload\": {\n        \"rawMaterialLotId\": \"{{rawMaterialLotId}}\",\n        \"theoreticalQty\": 12,\n        \"actualQty\": 12.05\n      },\n      \"occurredAt\": \"2026-10-04T10:00:00.000Z\",\n      \"deviceId\": \"postman-test\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/sync/events", "host": ["{{baseUrl}}"], "path": ["api", "sync", "events"] }
          }
        },
        {
          "name": "GET pdf/batch/:id (PDF del registro de lote)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Cookie", "value": "{{cookie}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/pdf/batch/{{productionOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pdf", "batch", "{{productionOrderId}}"]
            }
          }
        }
      ]
    },
    {
