              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"json\": {\n    \"rawMaterialId\": \"{{lessId}}\",\n    \"supplierLotCode\": \"{{loteProveedor}}\",\n    \"quantityReceived\": 120,\n    \"expiryDate\": \"2028-12-31\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/trpc/materials.receiveLot",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
