                "materials.receiveLot"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "  pm.collectionVariables.set('loteProveedor', 'PM-LESS-' + Date.now().toString().slice(-6));",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "  pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "  const data = pm.response.json().result.data.json;",
                  "  pm.test('El lote queda en cuarentena', () => pm.expect(data.status).to.eql('cuarentena'));",
                  "  pm.test('Recibe su QR interno', () => pm.expect(data.qrCode).to.be.a('string').and.not.empty);",
                  "  pm.collectionVariables.set('loteId', data.id);",
                  "})();"
                ]
              }
            }
          ]
        },
