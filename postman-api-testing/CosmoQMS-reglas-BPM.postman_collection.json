        "exec": [
          "// Un id de evento sin conexión por corrida, reutilizado en B5 y B6 para probar el duplicado.",
          "if (!pm.collectionVariables.get('eventoOffline') || pm.info.requestName.startsWith('A1')) {",
          "  pm.collectionVariables.set('eventoOffline', require('uuid').v4());",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "A · Datos y productos",
      "item": [
        {
          "name": "A1 · Salud del sistema y de la base de datos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "  pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "  const body = pm.response.json();",
                  "  pm.test('La app y la base responden', () => { pm.expect(body.status).to.eql('ok'); pm.expect(body.database).to.eql('ok'); });",
                  "  pm.test('Responde en menos de 1 segundo', () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "A2 · Catálogo con los productos nuevos (bodega)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "cosmoqms-demo-role=bodega"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/materias-primas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "materias-primas"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "  pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "  const list = pm.response.json().data;",
                  "  const byCode = (code) => list.find((m) => m.code === code);",
                  "  pm.test('El catálogo tiene al menos 19 materias primas', () => pm.expect(list.length).to.be.at.least(19));",
                  "  pm.test('Incluye las materias primas nuevas (MP-006 a MP-019)', () => ['MP-006','MP-011','MP-014','MP-019'].forEach((c) => pm.expect(byCode(c), c).to.be.an('object')));",
                  "  pm.collectionVariables.set('lessId', byCode('MP-006').id);",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "A3 · Fórmulas activas para producir (jefe de planta)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "cosmoqms-demo-role=jefe_planta"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/trpc/formulas.listActive",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trpc",
                "formulas.listActive"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "  pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "  const data = pm.response.json().result.data.json;",
                  "  const byCode = (code) => data.find((f) => f.code === code);",
                  "  pm.test('Hay al menos 7 fórmulas activas', () => pm.expect(data.length).to.be.at.least(7));",
                  "  pm.test('Están los productos nuevos F-004 a F-008', () => ['F-004','F-005','F-006','F-007','F-008'].forEach((c) => pm.expect(byCode(c), c).to.be.an('object')));",
                  "  pm.test('Todas están activas', () => data.forEach((f) => pm.expect(f.status).to.eql('active')));",
                  "  pm.collectionVariables.set('champuId', byCode('F-004').id);",
                  "})();"
                ]
              }
            }
          ]
        }
      ]
    },
