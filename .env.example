# Secretos de la base en Docker (generar cada uno con: openssl rand -hex 24)
# POSTGRES_PASSWORD: dueño de las tablas (cosmoqms_app), solo migraciones.
# RUNTIME_DB_PASSWORD: rol de la app (cosmoqms_runtime), sujeto a RLS.
POSTGRES_PASSWORD=
RUNTIME_DB_PASSWORD=

# Solo para Prisma / pnpm dev desde esta máquina (en Docker las fija compose):
# DATABASE_URL=postgresql://cosmoqms_runtime:<RUNTIME_DB_PASSWORD>@localhost:5433/cosmoqms
# DIRECT_URL=postgresql://cosmoqms_app:<POSTGRES_PASSWORD>@localhost:5433/cosmoqms
DATABASE_URL=
DIRECT_URL=

# HTTPS con Caddy (docker compose --profile https up -d)
APP_DOMAIN=localhost

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=

# Notificaciones por correo (opcional: sin estas dos, solo hay bandeja en la app)
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=

# Archivos adjuntos: local (disco / volumen Docker) o s3 (AWS S3, MinIO, Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Monitoreo con Sentry (opcional: sin DSN no se envía nada)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Backups (servicio backup de docker-compose)
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_RETENTION_DAYS=30
